# Variables públicas de la app: Expo las incluye en el bundle del cliente, no pongas secretos aquí.
# Client IDs de OAuth de Google para el inicio de sesión nativo (iOS/Android).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# La API key de Gemini NO va aquí: vive como secret de Cloud Functions (ver README).
